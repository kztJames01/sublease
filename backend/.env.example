# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_NAME=lease
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SSLMODE=prefer
# Or use a full URL:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis / Cache
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=lvspace
CACHE_TTL=60

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_NAME=lvspace_refresh
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_PATH=/api/auth/
JWT_REFRESH_COOKIE_DOMAIN=

# DRF throttling
API_PAGE_SIZE=20
DRF_THROTTLE_ANON=120/minute
DRF_THROTTLE_USER=600/minute
DRF_THROTTLE_AUTH=20/minute

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# OAuth — Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
